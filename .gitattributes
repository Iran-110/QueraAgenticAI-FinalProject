# Generated receipts stay inspectable but do not dominate the default review diff.
experiments/review_handoff/results-review-handoff-v*.json linguist-generated=true
experiments/gateway_handoff/results-gateway-handoff-v*.json linguist-generated=true

# The seed manifest pins exact bytes; checkout must not rewrite their line endings.
streamlit-data-for-dev-test/** -text

# Candidate reservations pin generator/output bytes on every team's checkout.
/scripts/propose_evaluation_families.py -text
/data/evaluation/candidates/*.json -text

# Original paid development receipt and preregistration remain exact byte artifacts.
/experiments/grounded_http_acceptance/connected-live-*.json -text
/experiments/grounded_http_acceptance/connected-live-result-*.json linguist-generated=true

# The dev coverage protocol pins packet bytes across Windows/macOS checkouts.
/experiments/dev_rag_coverage_v1/*.json -text
/experiments/dev_rag_coverage_v1/*receipt*.json linguist-generated=true
/experiments/dev_rag_coverage_v1/*review*.json linguist-generated=true
/experiments/dev_rag_coverage_v1/verification-v1.json linguist-generated=true

# Resource-guidance registrations and receipts bind complete checkout bytes.
/experiments/core_resource_guidance_v1/*.json -text
/experiments/core_resource_guidance_v1/*receipt*.json linguist-generated=true
/experiments/core_resource_guidance_v1/*review*.json linguist-generated=true
/experiments/core_resource_guidance_v1/verification-v1.json linguist-generated=true
